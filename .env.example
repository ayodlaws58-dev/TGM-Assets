MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tgm_assets
MYSQL_USER=tgm
MYSQL_PASSWORD=YOUR_CHOSEN_PASSWORD
# Resend takes precedence over SMTP when configured.
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=frontdesk@tgmeducation.net
# Published Resend templates (ID or alias). These are the defaults if left unset.
RESEND_TEMPLATE_PROCUREMENT=procurement
RESEND_TEMPLATE_WORK_ORDER=work-order-assigned
# Public address of the site, used for the buttons in emails sent outside a web request (reminders).
APP_BASE_URL=https://assets.tgmeducation.com
# Set to 1 when running behind Cloudflare Tunnel with Gunicorn on 127.0.0.1 (see DATABASE.md).
TRUST_PROXY=0
# Production: set a long random value so sessions survive restarts.
SECRET_KEY=
